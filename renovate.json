{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard", "local>edithatogo/renovate-config"],
  "gradle-wrapper": { "enabled": true },
  "ignoreUnstable": true,
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "automergeType": "pr",
  "platformAutomerge": true,
  "packageRules": [
    {
      "description": "Keep the Kotlin compiler, AndroidX and Compose BOM in one checked PR",
      "matchManagers": ["gradle"],
      "matchPackageNames": ["androidx.**", "org.jetbrains.kotlin**", "org.jetbrains.compose**"],
      "groupName": "AndroidX & Compose Ecosystem",
      "separateMajorMinor": false,
      "separateMinorPatch": false,
      "dependencyDashboardApproval": false,
      "automerge": true
    },
    {
      "description": "Compose Rules 0.4.x supports the stable Detekt 1.x plugin",
      "matchPackageNames": ["io.nlopez.compose.rules:detekt"],
      "allowedVersions": "<0.5.0"
    }
  ]
}
